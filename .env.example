# ─── HTTP ────────────────────────────────────────────────────────────────────
API_PORT=8080
# development | production. Em production o log sai em JSON.
ENVIRONMENT=development

# Protege as rotas /v1/admin. Vazio DESLIGA essas rotas (respondem 503).
# Gere com: openssl rand -base64 32
ADMIN_TOKEN=

# ─── Postgres 18 ─────────────────────────────────────────────────────────────
POSTGRES_USER=kangfiscal
POSTGRES_PASSWORD=kangfiscal
POSTGRES_DB=kangfiscal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# ─── Segredos ────────────────────────────────────────────────────────────────
# Cifra a chave privada do certificado A1, a senha dele e o CSC da NFC-e.
# 32 bytes em base64: openssl rand -base64 32
# Fica SÓ aqui. Perder ou trocar esta chave obriga a enviar os certificados de novo.
SECRETS_ENCRYPTION_KEY=

# ─── Responsável técnico (infRespTec) ───────────────────────────────────────
# A empresa que mantém o sistema emissor. Várias UFs exigem. Vazio = o grupo não vai.
RESP_TEC_CNPJ=
RESP_TEC_CONTACT=
RESP_TEC_EMAIL=
RESP_TEC_PHONE=

# ─── Inutilização automática (kang-fiscal worker) ───────────────────────────
# A cada VOID_SWEEP_MINUTES, inutiliza os números reservados há mais de VOID_AFTER_HOURS
# sem nota válida. Nota incerta nunca é inutilizada: é consultada antes.
VOID_SWEEP_MINUTES=60
VOID_AFTER_HOURS=24
