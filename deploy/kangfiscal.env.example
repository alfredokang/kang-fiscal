# Variáveis das stacks do Kang Fiscal no Portainer.
# Preencha e use em: Stack → Environment variables → "Load variables from .env file".
# NÃO commite este arquivo preenchido.

# ─── Obrigatórias ───────────────────────────────────────────────────────────
# O domínio da API (o DNS tem de apontar para o servidor; o Traefik emite o HTTPS).
API_DOMAIN=fiscal.seudominio.com.br

# A MESMA nas stacks postgres_kangfiscal, kangfiscal e backup_kangfiscal.
POSTGRES_PASSWORD=

# Gere cada um com: openssl rand -base64 32  (um valor diferente para cada)
ADMIN_TOKEN=
SECRETS_ENCRYPTION_KEY=
CREDENTIAL_PEPPER=

# ─── Recomendadas ───────────────────────────────────────────────────────────
# Responsável técnico: a empresa que mantém o emissor. Várias UFs exigem.
RESP_TEC_CNPJ=
RESP_TEC_CONTACT=
RESP_TEC_EMAIL=
RESP_TEC_PHONE=

# ─── Opcionais (os padrões servem) ──────────────────────────────────────────
# Versão da imagem: vazio = latest. Para fixar, o SHA do `make publish` (ex.: a68e70e).
IMAGE_TAG=
RATE_LIMIT_PER_MINUTE=600
VOID_SWEEP_MINUTES=60
VOID_AFTER_HOURS=24
